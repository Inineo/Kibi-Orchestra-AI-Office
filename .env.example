# =============================================================================
# KIBI ORCHESTRA AI WORKFORCE - ENVIRONMENT TEMPLATE
# Salin file ini menjadi `.env` atau `.env.local` dan isi dengan kredensial Anda.
# File `.env` sudah diabaikan di .gitignore untuk mencegah kebocoran data sensitif.
# =============================================================================

# --- 1. 9ROUTER AI GATEWAY ---
# Gateway lokal 9Router untuk orchestrator model multi-provider (Anthropic, Gemini, OpenAI, DeepSeek, Ollama)
VITE_9ROUTER_URL="http://localhost:20128"
VITE_9ROUTER_API_KEY=""

# --- 2. DEFAULT AI MODEL ---
# Model default yang digunakan oleh backend orchestrator
DEFAULT_AI_MODEL="openai/gpt-4o-mini"

# --- 3. GOOGLE GEMINI API (Opsional bila menggunakan Direct API) ---
GEMINI_API_KEY=""

# --- 4. ANTHROPIC & OPENAI API KEYS (Opsional jika direct / by-pass router) ---
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

# --- 5. DATABASE & BACKEND (Supabase / PostgreSQL) ---
# Diperlukan saat masuk fase persistensi misi & eksekusi agen
DATABASE_URL=""
DIRECT_URL=""
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- 6. OBSIDIAN VAULT INTEGRATION ---
# Path absolut ke Obsidian vault Anda (JANGAN COMMIT PATH PRIBADI!)
# Contoh Windows: D:\Obsidian\Obsidian Memories\antigravity
# Contoh macOS/Linux: /Users/username/Documents/Obsidian/antigravity
OBSIDIAN_ANTIGRAVITY_PATH=""
CURRENT_PROJECT_NAME="Kibi-Orchestra"

# --- 7. APPLICATION CONFIGURATION ---
VITE_APP_ENV="development"
VITE_ENABLE_AUDIO="true"
VITE_SIMULATION_INTERVAL_MS="3000"
APP_URL="http://localhost:5173"
